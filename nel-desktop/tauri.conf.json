{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nel Code",
  "mainBinaryName": "Nel Code",
  "identifier": "com.nelcode.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Nel Code",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "theme": "Dark",
        "backgroundColor": "#1a1a19"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Discuter avec des modèles MiniChat",
    "fileAssociations": [
      {
        "ext": [
          "nelmodel"
        ],
        "name": "Modèle Nel Code",
        "description": "Modèle MiniChat pour Nel Code",
        "role": "Viewer"
      }
    ],
    "publisher": "Nelson Rossi",
    "copyright": "© 2026 Nelson Rossi",
    "homepage": "https://github.com/nelsogi/nelcode-rs",
    "category": "Productivity",
    "licenseFile": "../LICENSE",
    "longDescription": "Nel Code discute avec les petits modèles de langage entraînés par MiniChat (.nelmodel), entièrement sur ton PC, sans connexion.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
